FROM --platform=linux/arm64 node:22.12-slim

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY src/grid-bot/ ./grid-bot
COPY src/exchanges/ ./exchanges
COPY src/utils/ ./utils

EXPOSE 3000

ENV NODE_ENV=production

ENV PAIR_NAME=USDP/USDT
ENV LOWER_PRICE=1.0005
ENV UPPER_PRICE=1.0044
ENV GRID_STEP=0.0010
ENV PRICE_PRECISION=4
ENV QUANTITY_PER_GRID=249
ENV MARKET_TYPE=spot
ENV IS_INFINITE_GRID=false
ENV LEVERAGE=1
ENV STOP_LOSS=0
ENV TAKE_PROFIT=0
# API_KEY and API_SECRET are injected at runtime (ECS task definition or --env-file); never bake them into the image.


CMD ["node", "grid-bot/run.js"]
