FROM --platform=linux/arm64 node:22.12-slim

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY src/grid-bot/ ./grid-bot
COPY src/exchanges/ ./exchanges
COPY src/utils/ ./utils

EXPOSE 3000

ENV NODE_ENV=production

ENV PAIR_NAME=ETH/USDT
ENV LOWER_PRICE=3100
ENV UPPER_PRICE=3600
ENV GRID_STEP=10
ENV PRICE_PRECISION=2
ENV QUANTITY_PER_GRID=0.0075
ENV MARKET_TYPE=linear
ENV IS_INFINITE_GRID=true
ENV LEVERAGE=5
ENV STOP_LOSS=0
ENV TAKE_PROFIT=0
# API_KEY and API_SECRET are injected at runtime (ECS task definition or --env-file); never bake them into the image.


CMD ["node", "grid-bot/run.js"]
