# Copy to .env (gitignored) and fill in. Loaded via `node --env-file=.env` (npm run grid-bot, wick-bot, ...).

# Local development / backtests
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
VOLUME_TRADED_API_KEY=
VOLUME_TRADED_API_SECRET=

# Containers (NODE_ENV=production reads these instead of the local config.js values)
API_KEY=
API_SECRET=
PAIR_NAME=BTC/USDT
MARKET_TYPE=linear        # spot | linear
LEVERAGE=3
LOGGER_LEVEL=info         # debug | info | warn | error

# Slack alerts (Terraform: TF_VAR_slack_webhook_url)
SLACK_WEBHOOK_URL=
