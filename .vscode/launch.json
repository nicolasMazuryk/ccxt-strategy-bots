{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Grid Bot",
            "env": {
                "IS_VSCODE_DEBUGGER": "true"
            },
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/src/grid-bot/run.js",
            "runtimeArgs": [
                "--max-old-space-size=8192"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Backtester",
            "env": {
                "IS_VSCODE_DEBUGGER": "true"
            },
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/src/backtester/run-backtest.js",
            "runtimeArgs": [
                "--max-old-space-size=8192"
            ]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Funding Sniper Bot",
            "env": {
                "IS_VSCODE_DEBUGGER": "true"
            },
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/src/funding-bot/run.js"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Funding Spot Perp Bot",
            "env": {
                "IS_VSCODE_DEBUGGER": "true"
            },
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/src/funding-arbitrage/funding-spot-perp.js"
